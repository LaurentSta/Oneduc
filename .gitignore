############################################
# ==============================
# LARAVEL / PHP
# ==============================
############################################

/vendor/
.env
.env.*
auth.json
Homestead.yaml
Homestead.json
/.vagrant
.phpunit.result.cache
/.phpunit.cache
.phpactor.json

############################################
# ==============================
# NODE / VITE
# ==============================
############################################

/node_modules/
npm-debug.log
yarn-error.log
/.vite
/.vite-inspect

############################################
# ==============================
# CACHE / STORAGE / LOGS
# ==============================
############################################

/bootstrap/cache/
/storage/*
!/storage/app
!/storage/app/.gitignore
!/storage/app/public
!/storage/app/public/.gitignore
!/storage/framework
!/storage/framework/.gitignore
!/storage/framework/cache
!/storage/framework/cache/.gitignore
!/storage/framework/sessions
!/storage/framework/sessions/.gitignore
!/storage/framework/views
!/storage/framework/views/.gitignore
!/storage/logs
!/storage/logs/.gitignore
storage/*.key

############################################
# ==============================
# SCORM (lourd)
# ==============================
############################################

/public/modules/scorm/*
/resources/scorm/

############################################
# ==============================
# PUBLIC : dépôt léger
# ==============================
############################################

# On ignore TOUT le dossier public
/public/*

# === Fichiers indispensables Laravel ===
!/public/index.php
!/public/.htaccess
!/public/robots.txt
!/public/favicon.ico

# === Ressources statiques utiles (non générées) ===
!/public/fonts/
!/public/fonts/**
!/public/images/
!/public/images/**
!/public/docs/
!/public/docs/**
!/public/confortplus/
!/public/confortplus/**
!/public/scorm_core/
!/public/scorm_core/**

# Moteurs réutilisables d'activités interactives (code source, pas du contenu importé)
!/public/activites-interactives/
!/public/activites-interactives/**

# === Si ces dossiers contiennent uniquement du statique livré ===
!/public/backend/
!/public/backend/**
!/public/frontend/
!/public/frontend/**

# Dossier modules : on ouvre uniquement parcours_formateur
!/public/modules/
/public/modules/*
!/public/modules/parcours_formateur
!/public/modules/parcours_formateur/**

############################################
# ==============================
# EXCLUSIONS DEFINITIVES (sécurité)
# ==============================
############################################

/public/build/
/public/hot
/public/storage/
/public/upload/
/public/phpmyadmin
/public/test.php

############################################
# ==============================
# OUTILS DEV LOCAL
# ==============================
############################################

/.agents/
/.backups/
/.codex/
/.claude/
/.vscode/
/temps/
